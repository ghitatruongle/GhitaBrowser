* text=auto
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.ico binary
*.png binary
*.zip binary

# Fixtures are hash-locked by tests/real_site_acceptance_test.rs; they must
# check out byte-for-byte identical on every platform (CI runners default to
# CRLF, which breaks the SHA-256 integrity verification).
tests/fixtures/** -text
