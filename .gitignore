# ── Operating System Generated ──────────────────────────────
# Windows
Thumbs.db
Thumbs.db:encryptable
desktop.ini
ehthumbs.db
ehthumbs_vista.db
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon?
Icon\r\r

# Linux
.directory
.Trash-*
.fuse_hidden*
.nfs*

