*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3
*.db
*.db-shm
*.db-wal
*.db-journal
*.db3

# Incomplete / Temp Downloads
*.crdownload
*.part
*.download

# Crash Dumps & Minidumps
*.dmp
*.dump
crashdump/
minidump/
Crashpad/

# ── Environment, Secrets & Cryptographic Keys ───────────────
