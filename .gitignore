/target/
**/*.rs.bk
*.bk
Cargo.lock.bk
*.rmeta
*.rlib
*.d
*.ll
*.bc
*.s
cargo-timing*.html
.cargo-ok

# ── Distribution & Packaging ────────────────────────────────
dist/
/dist/
portable/
/portable/
installer-output/
/installer-output/
Output/
packaging/Output/
*.iss.bak
*.exe
*.msi
*.msix
*.appx
*.appxbundle
*.msixbundle

# Archives
*.zip
*.tar
*.tar.gz
*.tgz
*.tar.bz2
*.tar.xz
*.7z
*.rar

# Checksums & Digests
*.sha256
*.sha256.txt
*.sha512
*.sha512.txt
*.md5

# ── Generated release-gate evidence & reports ───────────────
# Produced by tools/make-source-manifest.ps1 and validation gates;
# excluded from frozen source manifests and git tracking.
phase*-freeze.json
phase*-freeze.json.sha256.txt
phase*-report.json
phase*-clean-vm-report.json
*-release-smoke-*.json
personal-release-smoke-*.json
acceptance-report*.json
build-metrics/
*-gate-report.json

# ── Binaries, Native Libraries & Linker Artifacts ───────────
*.dll
*.so
*.dylib
*.pdb
*.exp
*.lib
*.a
*.o
*.obj
*.ilk
*.idb
*.map
*.def
*.node

# ── Windows Resource Build Artifacts ───────────────────────
*.res
*.rc.bak

# ── Browser Runtime Data, Cache & User State ────────────────
user_data/
/user_data/
.ghitabrowser_data/
/.ghitabrowser_data/
cache/
/cache/
downloads/
/downloads/
storage/
/storage/
local_storage/
indexeddb/
sessions/
cookies/
blob_storage/

