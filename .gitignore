.env.*
!.env.example

keys/
/keys/
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
*.der
*.asc
*.gpg
*.sig
*private-key*.txt
*private_key*.txt
*.secret
*.token
secrets.json
credentials.json

# ── Logs & Temporary Files ──────────────────────────────────
*.log
*.tmp
*.temp
*.bak
*.orig
*.rej
*.old
*~
crash-*.log

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Process runtime locks
*.pid
*.seed
*.pid.lock

